#!/usr/bin/env bash
set -Eeuo pipefail
if [[ ${1:-} == --version ]]; then
  printf 'apptainer version 1.3.0-fixture\n'
  exit 0
fi
[[ ${1:-} == exec ]] || exit 90
shift
while (($#)); do
  case "$1" in
    --cleanenv) shift ;;
    --bind) shift 2 ;;
    *) break ;;
  esac
done
shift # inert fixture image
mapped=()
for argument in "$@"; do
  # Map container bind-mount paths (/work -> BSSW_FAKE_RUNTIME_DIR). Two forms appear:
  #   1. a standalone argument that IS the path:   /work/input.json
  #   2. a path embedded in a -c script string:    ...open("/work/endpoint.json"...
  # Require /work/ to follow a quote or the start of the argument, never a path
  # segment, so checkout dirs like /home/runner/work/repo/ are left untouched.
  if [[ "$argument" == /work/* ]]; then
    argument="$BSSW_FAKE_RUNTIME_DIR/${argument#/work/}"
  fi
  argument="${argument//\"\/work\//\"$BSSW_FAKE_RUNTIME_DIR/}"
  mapped+=("$argument")
done
target=${mapped[1]:-}
case "${BSSW_FIXTURE_SCENARIO:-success}:$target" in
  early-coordinator-exit:*coordinator.py) exit 17 ;;
  worker-failure:*worker.py) exit 18 ;;
  verification-failure:*verify.py) exit 19 ;;
  readiness-timeout:*readiness.py) exit 24 ;;
esac
exec "${mapped[@]}"
