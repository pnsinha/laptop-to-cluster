---
import ThemeControl from './ThemeControl.astro';
import { NAV_ITEMS } from '../content/contracts';

const { currentPath = Astro.url.pathname } = Astro.props as { currentPath?: string };
const normalize = (path: string) => path === '/' ? path : `/${path.split('/').filter(Boolean).join('/')}/`;
const path = normalize(currentPath);
/* NAV_ITEMS labels the external item "GitHub (external)". The visible "(external)" stays a separate span so it keeps its own size floor. */
const links = NAV_ITEMS.map((item) => ({
  label: item.label.replace(/ \(external\)$/, ''),
  href: item.href as string,
  external: 'external' in item && item.external === true,
}));
const current = (href: string) => href.startsWith('/') && normalize(href) === path;
---
<header class="site-header">
  <div class="site-header__top">
    <a class="site-identity" href="/" aria-label="Laptop to Cluster home">
      <span class="site-identity__text">
        <span class="site-identity__line1">laptop-to-cluster</span>
        <span class="site-identity__line2">multi-service stacks under the scheduler</span>
      </span>
    </a>
    <nav aria-label="Primary"><ul class="site-nav site-nav--wide">
      {links.map((link) => <li><a class:list={['site-nav__link', { 'site-nav__link--external': link.external }]} href={link.href} rel={link.external ? 'external' : undefined} aria-current={!link.external && current(link.href) ? 'page' : undefined}>{link.label}{link.external && <span class="external-label">{' '}(external)</span>}</a></li>)}
    </ul></nav>
    <details class="site-nav--compact">
      <summary>Navigation</summary>
      <nav aria-label="Primary navigation menu"><ul class="site-nav">
        {links.map((link) => <li><a class:list={['site-nav__link', { 'site-nav__link--external': link.external }]} href={link.href} rel={link.external ? 'external' : undefined} aria-current={!link.external && current(link.href) ? 'page' : undefined}>{link.label}{link.external && <span class="external-label">{' '}(external)</span>}</a></li>)}
      </ul></nav>
    </details>
    <ThemeControl />
  </div>
</header>
