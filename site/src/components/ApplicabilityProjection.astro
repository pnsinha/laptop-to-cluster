---
import type { ApplicabilityProjection } from '../content/projections';
import { RECORD_LINK_TEXT } from '../content/wording';
const { projection } = Astro.props as { projection: ApplicabilityProjection };
const { panel } = projection;
---
{panel.collapsible ? (
  <section class="applicability-projection" data-projection-id={projection.projectionId} data-source-id={projection.recordId} aria-label="Tested workflow scope">
    <p class="evidence-badge">{panel.badgeLabel}</p>
    <p class="evidence-link">{panel.badgeContext ? `${panel.badgeContext} · ` : ''}<a href={panel.canonicalPath}>{RECORD_LINK_TEXT}</a></p>
    <details class="evidence-panel">
      <summary>What this means for you</summary>
      <dl class="evidence-rows">
        {panel.rows.map((row) => (
          <div class="evidence-row"><dt>{row.label}</dt><dd><ul>{row.items.map((item) => <li data-from={item.from.join(' ')}>{item.text}</li>)}</ul></dd></div>
        ))}
      </dl>
      <p class="evidence-untested"><a href={panel.untestedHref}>What hasn't been tested yet</a></p>
    </details>
  </section>
) : (
  <section class="applicability-projection applicability-projection--escalated" data-projection-id={projection.projectionId} data-source-id={projection.recordId} aria-label="Tested workflow scope">
    <p class="evidence-badge evidence-badge--warning"><strong>Warning:</strong> {panel.badgeLabel}</p>
    <p class="evidence-link">{panel.badgeContext ? `${panel.badgeContext} · ` : ''}<a href={panel.canonicalPath}>{RECORD_LINK_TEXT}</a></p>
    <dl class="evidence-rows">
      {panel.rows.map((row) => (
        <div class="evidence-row"><dt>{row.label}</dt><dd><ul>{row.items.map((item) => <li data-from={item.from.join(' ')}>{item.text}</li>)}</ul></dd></div>
      ))}
    </dl>
  </section>
)}
