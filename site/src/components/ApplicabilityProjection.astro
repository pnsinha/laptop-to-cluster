---
import type { ApplicabilityProjection } from '../content/projections';
const { projection } = Astro.props as { projection: ApplicabilityProjection };
const isEscalated = projection.supplement.kind === 'status';
---
{isEscalated ? (
  <section class="applicability-projection applicability-projection--escalated" data-projection-id={projection.projectionId} data-source-id={projection.recordId} aria-label="Tested workflow scope">
    <p><strong>Status:</strong> {projection.supplement.text}</p>
    <p class="applicability-supplement">{projection.testedScope}</p>
    <p><a href={projection.canonicalPath}>Review the complete applicability record.</a></p>
  </section>
) : (
  <section class="applicability-projection" data-projection-id={projection.projectionId} data-source-id={projection.recordId} aria-label="Tested workflow scope">
    <p><strong>Tested scope:</strong> {projection.testedScope}</p>
    <p class="applicability-supplement">{projection.supplement.text}</p>
    <p><a href={projection.canonicalPath}>View applicability record.</a></p>
  </section>
)}
