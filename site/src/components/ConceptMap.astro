---
import { CONCEPTS } from '../content/contracts';
import { BIG_IDEA, CONCEPT_NOTES } from '../content/home';
---
<section class="concepts" id="big-idea" aria-labelledby="big-idea-title">
  <h2 id="big-idea-title">{BIG_IDEA.title}</h2>
  <p class="concepts__intro" set:html={BIG_IDEA.proseHtml} />
  <div class="concepts__rows">
    {CONCEPTS.map(({ key, label, was }, index) => (
      <div class="concept" data-concept={key}>
        <p class="concept__n">{String(index + 1).padStart(2, '0')}</p>
        <p class="concept__was"><span class="concept__side">{BIG_IDEA.composeSide}</span>{was}</p>
        <div class="concept__to">
          <span class="concept__side">{BIG_IDEA.clusterSide}</span>
          <span class={`concept__term c-${key}`}>{label}</span>
          <p class="concept__note" set:html={CONCEPT_NOTES[key]} />
        </div>
      </div>
    ))}
  </div>
</section>
