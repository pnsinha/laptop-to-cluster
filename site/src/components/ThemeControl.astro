<div class="theme-control" data-theme-control hidden><span class="theme-control__label">Theme</span><button type="button" data-theme-choice="system" aria-pressed="true">System</button><button type="button" data-theme-choice="light" aria-pressed="false">Light</button><button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button></div>
<script is:inline>(()=>{const d=document,b=d.querySelector('[data-theme-control]');const r=d.documentElement,k='l2c-theme',m=d.querySelectorAll('meta[name=theme-color]'),p=c=>{c=='system'?r.removeAttribute('data-theme'):r.dataset.theme=c;for(const e of m)e.content=c=='dark'||c>'s'&&e.getAttribute('media').includes('dark')?'#131a29':'#fbf9f4';for(const e of b.querySelectorAll('button'))e.setAttribute('aria-pressed',''+(e.dataset.themeChoice==c))};b.addEventListener('click',e=>{const c=e.target.closest('button')?.dataset.themeChoice;if(!c)return;try{localStorage[c>'s'?'removeItem':'setItem'](k,c)}catch{}p(c)});let s;try{s=localStorage.getItem(k)}catch{}p(s=='light'||s=='dark'?s:'system');b.hidden=false})()</script>
