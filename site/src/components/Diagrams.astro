---
const { name } = Astro.props as { name: string };
---
{name === 'compose-to-hpc' && (
  <figure class="diagram" role="img" aria-label="Compose-to-HPC concept mapping diagram. Docker Compose concepts on the left map to their scheduler-managed HPC equivalents on the right.">
    <svg viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" class="diagram-svg" role="group" aria-hidden="true" style="color: var(--primary);">
      <text x="80" y="25" class="hdr hdr--primary" text-anchor="middle">Docker Compose</text>
      <text x="640" y="25" class="hdr hdr--primary" text-anchor="middle">HPC (Slurm + Apptainer)</text>
      <line x1="80" y1="35" x2="80" y2="335" class="lane"/>
      <line x1="640" y1="35" x2="640" y2="335" class="lane"/>

      <rect x="10" y="50" width="140" height="35" class="box-l"/><text x="80" y="72" class="lbl" text-anchor="middle">service</text>
      <rect x="570" y="50" width="140" height="35" class="box-r"/><text x="640" y="72" class="lbl" text-anchor="middle">srun job step</text>
      <line x1="150" y1="67" x2="570" y2="67" class="arr" marker-end="url(#arrowhead)"/>

      <rect x="10" y="100" width="140" height="35" class="box-l"/><text x="80" y="122" class="lbl" text-anchor="middle">image / build</text>
      <rect x="570" y="100" width="140" height="35" class="box-r"/><text x="640" y="122" class="lbl" text-anchor="middle">.sif (apptainer)</text>
      <line x1="150" y1="117" x2="570" y2="117" class="arr" marker-end="url(#arrowhead)"/>

      <rect x="10" y="150" width="140" height="35" class="box-l"/><text x="80" y="172" class="lbl" text-anchor="middle">depends_on</text>
      <rect x="570" y="150" width="140" height="35" class="box-r"/><text x="640" y="172" class="lbl" text-anchor="middle">readiness gate</text>
      <line x1="150" y1="167" x2="570" y2="167" class="arr" marker-end="url(#arrowhead)"/>

      <rect x="10" y="200" width="140" height="35" class="box-l"/><text x="80" y="222" class="lbl" text-anchor="middle">volumes</text>
      <rect x="570" y="200" width="140" height="35" class="box-r"/><text x="640" y="222" class="lbl" text-anchor="middle">job-scoped scratch</text>
      <line x1="150" y1="217" x2="570" y2="217" class="arr" marker-end="url(#arrowhead)"/>

      <rect x="10" y="250" width="140" height="35" class="box-l"/><text x="80" y="272" class="lbl" text-anchor="middle">ports</text>
      <rect x="570" y="250" width="140" height="35" class="box-r"/><text x="640" y="272" class="lbl" text-anchor="middle">loopback + tunnel</text>
      <line x1="150" y1="267" x2="570" y2="267" class="arr" marker-end="url(#arrowhead)"/>

      <rect x="10" y="300" width="140" height="35" class="box-l"/><text x="80" y="322" class="lbl" text-anchor="middle">device_requests</text>
      <rect x="570" y="300" width="140" height="35" class="box-r"/><text x="640" y="322" class="lbl" text-anchor="middle">--gres=gpu</text>
      <line x1="150" y1="317" x2="570" y2="317" class="arr" marker-end="url(#arrowhead)"/>

      <defs><marker id="arrowhead" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="currentColor"/></marker></defs>
    </svg>
  </figure>
)}

{name === 'single-node-architecture' && (
  <figure class="diagram" role="img" aria-label="Single-node architecture diagram. Inside one scheduler allocation: a coordinator service starts first on loopback, a readiness gate polls until the coordinator answers, workers launch only after readiness passes, then a verifier checks all results before writing a success marker.">
    <svg viewBox="0 0 720 420" xmlns="http://www.w3.org/2000/svg" class="diagram-svg" role="group" aria-hidden="true">

      {/* Allocation boundary */}
      <rect x="20" y="60" width="680" height="340" class="alloc-border"/>
      <text x="360" y="50" class="hdr" text-anchor="middle">SCHEDULER ALLOCATION (1 node)</text>

      {/* Coordinator */}
      <rect x="50" y="90" width="200" height="70" class="box" rx="6"/>
      <text x="150" y="115" class="lbl" text-anchor="middle">Coordinator</text>
      <text x="150" y="132" class="sub" text-anchor="middle">apptainer exec</text>
      <text x="150" y="146" class="sub" text-anchor="middle">127.0.0.1:PORT</text>

      {/* Readiness gate */}
      <rect x="50" y="200" width="200" height="60" class="box" rx="6"/>
      <text x="150" y="225" class="lbl" text-anchor="middle">Readiness gate</text>
      <text x="150" y="242" class="sub" text-anchor="middle">poll /health until ready</text>

      {/* Workers */}
      <rect x="340" y="90" width="160" height="50" class="box" rx="6"/>
      <text x="420" y="115" class="lbl" text-anchor="middle">Worker 1</text>
      <text x="420" y="130" class="sub" text-anchor="middle">srun apptainer exec</text>

      <rect x="340" y="150" width="160" height="50" class="box" rx="6"/>
      <text x="420" y="175" class="lbl" text-anchor="middle">Worker 2</text>
      <text x="420" y="190" class="sub" text-anchor="middle">srun apptainer exec</text>

      <rect x="340" y="210" width="160" height="50" class="box" rx="6"/>
      <text x="420" y="235" class="lbl" text-anchor="middle">Worker N</text>
      <text x="420" y="250" class="sub" text-anchor="middle">srun apptainer exec</text>

      {/* Verifier */}
      <rect x="50" y="300" width="200" height="60" class="box" rx="6"/>
      <text x="150" y="325" class="lbl" text-anchor="middle">Verifier</text>
      <text x="150" y="342" class="sub" text-anchor="middle">check count, schema, digests</text>

      {/* Scratch */}
      <rect x="560" y="90" width="110" height="170" class="recessed" stroke="var(--border)" stroke-width="1" rx="6"/>
      <text x="615" y="120" class="sub" text-anchor="middle">Job-scoped</text>
      <text x="615" y="135" class="sub" text-anchor="middle">scratch</text>
      <text x="615" y="155" class="sub" text-anchor="middle">$SCRATCH/</text>
      <text x="615" y="170" class="lbl" text-anchor="middle">/data</text>
      <text x="615" y="200" class="sub" text-anchor="middle">tasks/</text>
      <text x="615" y="215" class="sub" text-anchor="middle">results/</text>
      <text x="615" y="230" class="sub" text-anchor="middle">logs/</text>

      {/* Success marker */}
      <rect x="50" y="370" width="200" height="35" class="recessed-ok" rx="6"/>
      <text x="150" y="392" class="tag" text-anchor="middle">result.json (success)</text>

      {/* Arrows */}
      <line x1="150" y1="160" x2="150" y2="200" class="arrow" marker-end="url(#ah)"/>
      <text x="165" y="185" class="sub">starts</text>

      <line x1="250" y1="230" x2="340" y2="130" class="gate-arrow" marker-end="url(#ah-green)"/>
      <text x="290" y="175" class="tag">ready</text>

      <line x1="340" y1="260" x2="200" y2="300" class="arrow" marker-end="url(#ah)"/>
      <text x="250" y="290" class="sub">results</text>

      <line x1="150" y1="360" x2="150" y2="370" class="arrow" marker-end="url(#ah)"/>

      <defs>
        <marker id="ah" markerWidth="7" markerHeight="5" refX="6" refY="2.5" orient="auto"><polygon points="0 0, 7 2.5, 0 5" fill="var(--muted)"/></marker>
        <marker id="ah-green" markerWidth="7" markerHeight="5" refX="6" refY="2.5" orient="auto"><polygon points="0 0, 7 2.5, 0 5" fill="var(--success)"/></marker>
      </defs>
    </svg>
  </figure>
)}

{name === 'readiness-sequence' && (
  <figure class="diagram" role="img" aria-label="Readiness gate sequence diagram showing how the coordinator starts first, the readiness gate polls until the coordinator responds, and only then do workers launch.">
    <svg viewBox="0 0 720 380" xmlns="http://www.w3.org/2000/svg" class="diagram-svg" role="group" aria-hidden="true">
      <line x1="10" y1="30" x2="710" y2="30" class="tl"/>
      <text x="10" y="20" class="note">TIME</text>

      {/* Lane labels */}
      <text x="80" y="50" class="lbl" text-anchor="middle">Coordinator</text>
      <text x="260" y="50" class="lbl" text-anchor="middle">Readiness gate</text>
      <text x="480" y="50" class="lbl" text-anchor="middle">Workers</text>

      {/* Step 1: coordinator starts */}
      <rect x="30" y="60" width="100" height="30" class="bar"/>
      <text x="80" y="80" class="step" text-anchor="middle">start</text>
      <text x="145" y="80" class="note">1. coordinator launches</text>

      {/* Step 2: coordinator booting */}
      <rect x="30" y="100" width="120" height="30" class="bar"/>
      <text x="80" y="120" class="step" text-anchor="middle">booting...</text>
      <text x="160" y="120" class="note">2. service initializing</text>

      {/* Step 3: poll 1 - no */}
      <rect x="220" y="140" width="80" height="25" class="bar"/>
      <text x="260" y="157" class="step" text-anchor="middle">poll</text>
      <text x="310" y="157" class="no">NO</text>
      <text x="340" y="157" class="note">3. not ready yet</text>

      {/* Step 4: poll 2 - no */}
      <rect x="220" y="175" width="80" height="25" class="bar"/>
      <text x="260" y="192" class="step" text-anchor="middle">poll</text>
      <text x="310" y="192" class="no">NO</text>
      <text x="340" y="192" class="note">4. still booting</text>

      {/* Step 5: coordinator ready */}
      <rect x="30" y="210" width="100" height="25" class="ready-bar"/>
      <text x="80" y="227" class="ok" text-anchor="middle">READY</text>
      <text x="145" y="227" class="note">5. /health responds</text>

      {/* Step 6: poll 3 - yes */}
      <rect x="220" y="245" width="80" height="25" class="ready-bar"/>
      <text x="260" y="262" class="step" text-anchor="middle">poll</text>
      <text x="310" y="262" class="ok">YES</text>
      <text x="340" y="262" class="note">6. readiness confirmed</text>

      {/* Step 7: workers launch */}
      <rect x="440" y="285" width="80" height="30" class="launch-bar"/>
      <text x="480" y="305" class="step" text-anchor="middle">launch</text>
      <text x="535" y="305" class="note">7. workers start</text>

      {/* Step 8: work runs */}
      <rect x="440" y="325" width="80" height="30" class="bar"/>
      <text x="480" y="345" class="step" text-anchor="middle">working</text>
      <text x="535" y="345" class="note">8. tasks processed</text>

      {/* Timeline arrows */}
      <line x1="80" y1="130" x2="80" y2="210" class="tl"/>
      <line x1="260" y1="140" x2="260" y2="270" class="tl"/>
      <line x1="260" y1="270" x2="440" y2="295" class="gate-arrow" marker-end="url(#seq-ah)"/>

      <defs><marker id="seq-ah" markerWidth="7" markerHeight="5" refX="6" refY="2.5" orient="auto"><polygon points="0 0, 7 2.5, 0 5" fill="var(--success)"/></marker></defs>
    </svg>
  </figure>
)}
