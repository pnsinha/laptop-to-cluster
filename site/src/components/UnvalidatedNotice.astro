---
/* Sections of a page that have not been validated, as a Starlight caution aside. The heading
   text "Unvalidated content" stays visible: the publication validator requires it outside any
   disclosure. */
import { Aside } from '@astrojs/starlight/components';
interface Scope { anchor: string; reason: string }
const { scopes = [] } = Astro.props as { scopes?: Scope[] };
---
{scopes.length > 0 && (
  <Aside type="caution" title="Unvalidated content">
    <ul>{scopes.map((scope) => <li><a href={`#${scope.anchor}`}>{scope.anchor}</a>: {scope.reason}</li>)}</ul>
  </Aside>
)}
