---
/* The three doors as Starlight cards. The card title is the audience line, so a reader
   self-selects first; the door's name is a heading inside the card, then the summary and the
   one link that is the target. */
import { Card, CardGrid } from '@astrojs/starlight/components';
import type { Door, DoorId } from '../content/contracts';

interface Props {
  doors: (Door & { summary: string; path?: { label: string; href: string }[] })[];
}

const { doors } = Astro.props;
const ICONS: Record<DoorId, 'open-book' | 'random' | 'setting'> = { understand: 'open-book', translate: 'random', evaluate: 'setting' };
const escape = (value: string) => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;');
---
<div class="doors not-content" id="doors">
  <CardGrid>
    {doors.map(({ id, eyebrow, title, summary, href, linkText }) => (
      <Card title={escape(eyebrow)} icon={ICONS[id]}>
        <div class="door" id={`door-${id}`}>
          <h3 class="door__title">{title}</h3>
          <p class="door__summary">{summary}</p>
          <p class="door__go"><a class="door__link" href={href}>{linkText}</a></p>
        </div>
      </Card>
    ))}
  </CardGrid>
</div>
