---
/* Every page of the site is a Starlight page. This layout passes the page's title, description
   and chrome to StarlightPage, builds the sidebar from the content collection, and marks the
   content with the composition profile the publication validator checks. */
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import StarlightPage, { type StarlightPageProps } from '@astrojs/starlight/components/StarlightPage.astro';
import { assertKnownCompositionProfile, currentBaselineRecord, type CompositionProfile } from '../content/projections';
import { buildSidebar, toStarlightSidebar } from '../content/sidebar';

interface Props {
  title: string;
  description: string;
  profile: CompositionProfile;
  headings?: MarkdownHeading[];
  frontmatter?: Partial<StarlightPageProps['frontmatter']>;
  hasSidebar?: boolean;
}
const { title, description, profile, headings = [], frontmatter = {}, hasSidebar } = Astro.props;
const selectedProfile = assertKnownCompositionProfile(profile, Astro.url.pathname);
const items = (await getCollection('contentItems')).map(({ data }) => data);
const record = currentBaselineRecord((await getCollection('applicability')).map(({ data }) => data));
const sidebar = toStarlightSidebar(buildSidebar(items, record));
---
<StarlightPage frontmatter={{ title, description, ...frontmatter }} {headings} {sidebar} {hasSidebar}>
  <div class="l2c-page" data-composition-profile={selectedProfile}><slot /></div>
</StarlightPage>
