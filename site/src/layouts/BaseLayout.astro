---
import '../styles/global.css';
import Attribution from '../components/Attribution.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { CANONICAL_ORIGIN } from '../content/schema';
import { assertKnownCompositionProfile, type CompositionProfile } from '../content/projections';
import { PROJECT } from '../content/wording';
const { title, description, profile, canonicalPath = Astro.url.pathname } = Astro.props as {
  title: string;
  description: string;
  profile: CompositionProfile;
  canonicalPath?: string;
};
const selectedProfile = assertKnownCompositionProfile(profile, Astro.url.pathname);
const currentPath = Astro.url.pathname;
const canonical = new URL(canonicalPath, CANONICAL_ORIGIN).href;
---
<!doctype html><html lang="en"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} /><meta property="og:type" content="website" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="Laptop-to-Cluster updates" href={`${CANONICAL_ORIGIN}/feed.xml`} />
  <link rel="sitemap" href={`${CANONICAL_ORIGIN}/sitemap-index.xml`} /><title>{title} | {PROJECT.name}</title>
</head><body data-composition-profile={selectedProfile}><a class="skip" href="#main">Skip to content</a>
<SiteHeader {currentPath} />
<main id="main" tabindex="-1">{currentPath !== '/' && <Breadcrumbs currentPath={currentPath} currentTitle={title} />}<slot /></main>
<footer class="site-footer"><Attribution compact /><p class="acknowledgment">This work was supported by the Better Scientific Software Fellowship Program, a collaborative effort of the U.S. Department of Energy (DOE), Office of Advanced Scientific Research via ANL under Contract DE-AC02-06CH11357 and the National Nuclear Security Administration Advanced Simulation and Computing Program via LLNL under Contract DE-AC52-07NA27344; and by the National Science Foundation (NSF) via SHI under Grant No. 2435328.</p><p class="acknowledgment">Any opinions, findings, and conclusions or recommendations expressed in this material are those of the author(s) and do not necessarily reflect the views of the DOE or NSF.</p><p>Found a problem? <a href={PROJECT.issues}>Open an issue.</a></p><p><a href="/about/accessibility/">Accessibility</a> · <a href="/about/support/">Contact and maintenance</a> · <a href="/about/licenses/">Licenses</a> · <a href="/milestones/1/">Milestone 1</a></p></footer>
</body></html>
