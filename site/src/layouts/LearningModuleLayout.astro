---
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import BodySegments from '../components/BodySegments.astro';
import ApplicabilityProjectionView from '../components/ApplicabilityProjection.astro';
import Diagrams from '../components/Diagrams.astro';
import ImplementationReference from '../components/ImplementationReference.astro';
import SourcesAndScope from '../components/SourcesAndScope.astro';
import Timeline from '../components/Timeline.astro';
import UnvalidatedNotice from '../components/UnvalidatedNotice.astro';
import { inlineCodeHtml } from '../content/inline-code';
import { TIMELINE_CAPTIONS } from '../content/timeline';
import { canonicalPath } from '../content/registry';
import { diagnosticHref, displayDiagnosticCode } from '../content/diagnostics';
import { IMPLEMENTATION_REFERENCE } from '../content/implementation';
import { DIAGRAMS_BY_ITEM, TIMELINE_BY_ITEM, headingsFromBody, lastUpdatedOf, learningPathNavigation, pageHeaderLine, pathPagination, slotNames, statusNotices } from '../content/page-chrome';
import { assertCompositionProfile, projectApplicabilityForItem, projectModuleNavigation } from '../content/projections';
import type { ContentItem, RepoRef } from '../content/schema';
type LearningModule = Extract<ContentItem, { artifact_type: 'learning-module' }>;
const { item, bodyHtml, renderedHeadings = [], editUrl } = Astro.props as { item: LearningModule; bodyHtml?: string; renderedHeadings?: MarkdownHeading[]; editUrl?: string };
const profile = item.module_type === 'conceptual' ? 'learning-conceptual' : 'learning-runnable';
assertCompositionProfile(item, profile);
const applicability = profile === 'learning-runnable'
  ? (await getCollection('applicability')).map(({ data }) => data)
  : [];
const projection = profile === 'learning-runnable'
  ? projectApplicabilityForItem(item, applicability, 'runnable-module')
  : undefined;
const contentItems = (await getCollection('contentItems')).map(({ data }) => data);
const contentById = new Map(contentItems.map((data) => [data.id, data]));
const pathNavigation = learningPathNavigation(contentItems, item.id);
const navigation = pathNavigation ?? projectModuleNavigation(contentItems)[item.id] ?? {};
/* "Continue learning" lists related pages the pager does not already offer as previous or next. */
const pagerUrls = new Set([navigation.previous?.url, navigation.next?.url].filter(Boolean));
const related = item.related.flatMap((id) => contentById.get(id) ?? []).filter((entry) => !pagerUrls.has(canonicalPath(entry)));
const repositoryHref = (reference: RepoRef) => `${reference.repository}/blob/${encodeURIComponent(reference.release)}/${reference.path.split('/').map(encodeURIComponent).join('/')}${reference.line_anchor ?? ''}`;
const markers = new Set(bodyHtml ? slotNames(bodyHtml) : []);
const timeline = TIMELINE_BY_ITEM[item.id];
const diagrams = DIAGRAMS_BY_ITEM[item.id] ?? [];
const runnable = profile === 'learning-runnable';
const resources = item.required_resources ?? [];

/* The table of contents: the overview, the body's own headings (with the implementation reference where its marker sits), then the closing sections. */
const implementationHeading = { depth: 2, slug: 'implementation-reference-heading', text: 'Implementation reference' };
const bodyHeadings = bodyHtml ? headingsFromBody(bodyHtml, runnable ? { 'implementation-reference': implementationHeading } : {}) : renderedHeadings;
const headings: MarkdownHeading[] = [
  { depth: 2, slug: 'module-overview-heading', text: 'In this module' },
  ...bodyHeadings,
  ...(runnable && !markers.has('implementation-reference') ? [implementationHeading] : []),
  { depth: 2, slug: 'completion', text: profile === 'learning-conceptual' ? 'Complete the decision exercise' : 'Check completion' },
  ...(related.length > 0 ? [{ depth: 2, slug: 'related', text: 'Continue learning' }] : []),
  ...(item.supporting_artifacts.length > 0 ? [{ depth: 2, slug: 'repository', text: 'Workflow package on GitHub' }] : []),
  ...(item.authority.length > 0 ? [{ depth: 2, slug: 'sources-scope-heading', text: 'Sources and scope' }] : []),
];
const frontmatter = {
  lastUpdated: lastUpdatedOf(item),
  editUrl,
  ...pathPagination(pathNavigation),
  l2c: { kindLine: pageHeaderLine(item), lede: item.summary, notices: statusNotices(item) },
};
---
<BaseLayout title={item.title} description={item.summary} {profile} {headings} {frontmatter}>
  {projection && <ApplicabilityProjectionView {projection} />}
  <section class="module-overview" aria-labelledby="module-overview-heading">
    <h2 id="module-overview-heading">In this module</h2>
    <ul>{item.learning_outcomes.map((value) => <li>{value}</li>)}</ul>
    {(runnable || item.prerequisites.length > 0) && <>
      <h3>Prerequisites</h3>
      <ul>
        {item.prerequisites.length ? item.prerequisites.map((value) => <li><Fragment set:html={inlineCodeHtml(value.check ?? value.id)} />{value.diagnostic_id && <>—<a href={diagnosticHref(value.diagnostic_id)}>{displayDiagnosticCode(value.diagnostic_id)}</a></>}</li>) : <li>No execution prerequisite is required.</li>}
        {resources.map((value) => <li>{value}</li>)}
      </ul>
    </>}
  </section>
  <UnvalidatedNotice scopes={item.unvalidated_scopes} />
  {timeline && !markers.has('timeline') && <Timeline highlight={timeline.highlight} captions={TIMELINE_CAPTIONS} />}
  <article class="module-content">
    {bodyHtml ? (
      <BodySegments html={bodyHtml}>
        <Fragment slot="timeline">{timeline && <Timeline highlight={timeline.highlight} captions={TIMELINE_CAPTIONS} />}</Fragment>
        <Fragment slot="diagram-compose-to-hpc">{diagrams.includes('compose-to-hpc') && <Diagrams name="compose-to-hpc" />}</Fragment>
        <Fragment slot="diagram-readiness-sequence">{diagrams.includes('readiness-sequence') && <Diagrams name="readiness-sequence" />}</Fragment>
        <Fragment slot="diagram-single-node-architecture">{diagrams.includes('single-node-architecture') && <Diagrams name="single-node-architecture" />}</Fragment>
        <Fragment slot="implementation-reference">{runnable && <ImplementationReference reference={IMPLEMENTATION_REFERENCE} />}</Fragment>
      </BodySegments>
    ) : <slot />}
  </article>
  {diagrams.filter((name) => !markers.has(`diagram-${name}`)).map((name) => <Diagrams {name} />)}
  {runnable && !markers.has('implementation-reference') && <ImplementationReference reference={IMPLEMENTATION_REFERENCE} />}
  <section class="reading-section" aria-labelledby="completion"><h2 id="completion">{profile === 'learning-conceptual' ? 'Complete the decision exercise' : 'Check completion'}</h2><p>{item.completion_check?.text}</p>{item.conceptual_check && <p>{item.conceptual_check.text}</p>}</section>
  {related.length > 0 && <section class="reading-section" aria-labelledby="related"><h2 id="related">Continue learning</h2><ul>{related.map((entry) => <li><a href={canonicalPath(entry)}>{entry.title}</a></li>)}</ul></section>}
  {item.supporting_artifacts.length > 0 && <section class="reading-section" aria-labelledby="repository"><h2 id="repository">Workflow package on GitHub</h2><ul>{item.supporting_artifacts.map((reference) => <li><a href={repositoryHref(reference)}><code>{reference.path}</code> at {reference.release}</a></li>)}</ul></section>}
  <SourcesAndScope references={item.authority} />
</BaseLayout>
