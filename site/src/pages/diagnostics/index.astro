---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiagnosticApplicabilityContextView from '../../components/DiagnosticApplicabilityContext.astro';
import { displayDiagnosticCode } from '../../content/diagnostics';
import { projectDiagnosticApplicabilityContext } from '../../content/projections';
const entries = (await getCollection('contentItems', ({ data }) => data.artifact_type === 'diagnostic' && data.status === 'published'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const applicability = (await getCollection('applicability')).map(({ data }) => data);
const sections = await Promise.all(entries.map(async (entry) => ({
  entry,
  Content: (await render(entry)).Content,
  context: entry.data.artifact_type === 'diagnostic' ? projectDiagnosticApplicabilityContext(entry.data, applicability) : undefined,
})));
---
<BaseLayout title="Diagnostic registry" description="Short reader codes, stable workflow identifiers, and recovery guidance for every documented baseline failure mode." profile="diagnostic">
<header class="content-header">
  <span class="eyebrow">Diagnostics</span>
  <h1>Find a failure by symptom</h1>
  <p class="lede">Choose the symptom you see. Each section shows a short reader code and the stable identifier to use in logs and issue reports.</p>
</header>
<nav aria-label="Diagnostics on this page">
  <ul class="diagnostic-index">{entries.map(({ data }) => <li><a href={`#${data.stable_slug}`}>{data.title}</a><span><strong>Code:</strong> <code>{displayDiagnosticCode(data.id)}</code> <span class="diagnostic-stable-id">Stable identifier: <code>{data.id}</code></span><br />{data.summary}</span></li>)}</ul>
</nav>
{sections.map(({ entry, Content, context }) => <section class="prose" id={entry.data.stable_slug} aria-labelledby={`${entry.data.stable_slug}-heading`}>
  <h2 id={`${entry.data.stable_slug}-heading`}>{entry.data.title}</h2>
  <p class="diagnostic-code"><strong>Code:</strong> <code>{displayDiagnosticCode(entry.data.id)}</code> <span class="diagnostic-stable-id">Stable identifier: <code>{entry.data.id}</code></span></p>
  <Content />
  {context && <DiagnosticApplicabilityContextView context={context} />}
</section>)}
<p class="prose">If execution is blocked, you can still use the conceptual modules and local adaptation guidance. If no symptom matches, <a href="/about/support/">report a missing diagnostic</a> with sanitized reproduction details.</p>
</BaseLayout>
