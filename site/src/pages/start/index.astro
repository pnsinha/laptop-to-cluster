---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentHeader from '../../components/ContentHeader.astro';
import ModulePager from '../../components/ModulePager.astro';
import SourcesAndScope from '../../components/SourcesAndScope.astro';
import { IMPLEMENTATION_REFERENCE } from '../../content/implementation';
import { learningPathNavigation } from '../../content/page-chrome';
import { assertCompositionProfile, currentRecord } from '../../content/projections';
const entries = await getCollection('contentItems');
const entry = entries.find(({ data }) => data.route_namespace === 'start');
if (!entry) throw new Error('Missing published getting-started content item');
const { Content } = await render(entry);
const item = entry.data;
assertCompositionProfile(item, 'start');
const navigation = learningPathNavigation(entries.map(({ data }) => data), item.id) ?? {};
const record = currentRecord((await getCollection('applicability')).map(({ data }) => data));
---
<BaseLayout title={item.title} description={item.summary} profile="start">
  <ContentHeader {item} />
  <aside class="implementation-callout" aria-labelledby="implementation-callout-heading">
    <h2 id="implementation-callout-heading">Run the baseline</h2>
    <p>Use the release-pinned implementation rather than reconstructing the launcher from the conceptual overview.</p>
    <ul>
      <li><a class="action action--secondary" href={IMPLEMENTATION_REFERENCE.primarySourceUrl} rel="external">Open the v0.1.0 sbatch script (external)</a></li>
      <li><a href="/guide/baseline-single-node-pattern/#implementation-reference">Read the annotated implementation reference</a></li>
    </ul>
  </aside>
  <article class="start-path" aria-label="Running the example, step by step"><Content /></article>
  {record && (
    <section aria-labelledby="how-we-know-heading">
      <h2 id="how-we-know-heading">How we know this works</h2>
      <p>The example workflow has a published test record: what ran, where it ran, and what it checked. <a href={`/applicability/${record.id}/`}>Read the full test record</a>.</p>
    </section>
  )}
  <ModulePager {navigation} />
  <SourcesAndScope references={item.authority} />
</BaseLayout>
