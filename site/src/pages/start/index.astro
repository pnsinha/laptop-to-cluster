---
import { getCollection, render } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BodySegments from '../../components/BodySegments.astro';
import RunBaselineCallout from '../../components/RunBaselineCallout.astro';
import SourcesAndScope from '../../components/SourcesAndScope.astro';
import { currentReleaseVersion, RELEASE_REF_TOKEN, resolveReleaseRefs } from '../../content/release';
import { editUrlFor, headingsFromBody, lastUpdatedOf, learningPathNavigation, pathPagination, slotNames, statusNotices } from '../../content/page-chrome';
import { assertCompositionProfile, currentBaselineRecord } from '../../content/projections';
const entries = await getCollection('contentItems');
const entry = entries.find(({ data }) => data.route_namespace === 'start');
if (!entry) throw new Error('Missing published getting-started content item');
const { Content, headings: renderedHeadings } = await render(entry);
/* The clone command names the release with the @release token, resolved here as it is on the other pages. */
const bodyHtml = entry.rendered?.html === undefined ? undefined : resolveReleaseRefs(entry.rendered.html, currentReleaseVersion());
if (bodyHtml === undefined && entry.body?.includes(RELEASE_REF_TOKEN)) throw new Error(`${entry.id}: the release token needs rendered HTML to resolve`);
const item = entry.data;
assertCompositionProfile(item, 'start');
const record = currentBaselineRecord((await getCollection('applicability')).map(({ data }) => data));
const markers = new Set(bodyHtml ? slotNames(bodyHtml) : []);
const headings: MarkdownHeading[] = [
  ...(bodyHtml ? headingsFromBody(bodyHtml) : renderedHeadings),
  ...(record ? [{ depth: 2, slug: 'how-we-know-heading', text: 'How we know this works' }] : []),
  ...(item.authority.length > 0 ? [{ depth: 2, slug: 'sources-scope-heading', text: 'Sources and scope' }] : []),
];
const frontmatter = {
  lastUpdated: lastUpdatedOf(item),
  editUrl: editUrlFor(entry.filePath),
  ...pathPagination(learningPathNavigation(entries.map(({ data }) => data), item.id)),
  l2c: { lede: item.summary, notices: statusNotices(item) },
};
---
<BaseLayout title={item.title} description={item.summary} profile="start" {headings} {frontmatter}>
  <article class="start-path" aria-label="Running the example, step by step">
    {bodyHtml === undefined ? <Content /> : (
      <BodySegments html={bodyHtml}>
        <Fragment slot="implementation-callout"><RunBaselineCallout /></Fragment>
      </BodySegments>
    )}
  </article>
  {!markers.has('implementation-callout') && <RunBaselineCallout />}
  {record && (
    <section class="reading-section" aria-labelledby="how-we-know-heading">
      <h2 id="how-we-know-heading">How we know this works</h2>
      <p>The example workflow has a published test record: what ran, where it ran, and what it checked. <a href={`/applicability/${record.id}/`}>Read the full test record</a>.</p>
    </section>
  )}
  <SourcesAndScope references={item.authority} />
</BaseLayout>
