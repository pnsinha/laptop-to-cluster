---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { canonicalPath } from '../../content/registry';
const entries = (await getCollection('contentItems', ({ data }) => ['published', 'superseded', 'archived'].includes(data.status))).map(({ data }) => data);
const groups = [
  { id: 'learn', title: 'Learn the model', question: 'How does a laptop workflow change on HPC?', items: entries.filter((item) => item.artifact_type === 'learning-module') },
  { id: 'run', title: 'Run and recover', question: 'Can I run the baseline, and what should I do when a check fails?', items: entries.filter((item) => item.route_namespace === 'start' || item.artifact_type === 'diagnostic') },
  { id: 'project', title: 'Review the project', question: 'Where are release, milestone, policy, and public-information records?', items: entries.filter((item) => item.artifact_type !== 'learning-module' && item.route_namespace !== 'start' && item.artifact_type !== 'diagnostic') },
].filter(({ items }) => items.length);
const qualifier = (item: typeof entries[number]) => item.artifact_type === 'learning-module'
  ? `${item.module_type} module` : item.artifact_type === 'diagnostic' ? 'Recovery guide' : undefined;
---
<BaseLayout title="Resources" description="Complete no-JavaScript index of published Laptop-to-Cluster resources." profile="resources">
  <header class="content-header"><h1>Choose what you need</h1><p class="lede">Start with a question, then follow an ordinary link. The complete index works without JavaScript.</p></header>
  {groups.map((group) => <section class="resource-group" aria-labelledby={`resource-${group.id}`}><h2 id={`resource-${group.id}`}>{group.title}</h2><p>{group.question}</p><ul class="resource-index">
    {group.items.map((item) => <li><h3><a href={canonicalPath(item)}>{item.title}</a></h3><p>{item.summary}</p>{qualifier(item) && <p class="resource-qualifier">{qualifier(item)}</p>}</li>)}
  </ul></section>)}
</BaseLayout>
