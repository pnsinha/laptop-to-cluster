---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { canonicalPath } from '../../content/registry';
const entries = (await getCollection('contentItems', ({ data }) => ['published', 'superseded', 'archived'].includes(data.status))).map(({ data }) => data);
const groups = [
  { id: 'learn', title: 'Learn the model', question: 'How does a laptop workflow change on HPC?', items: entries.filter((item) => item.artifact_type === 'learning-module') },
  { id: 'run', title: 'Run and recover', question: 'Can I run the baseline, and what should I do when a check fails?', items: entries.filter((item) => item.route_namespace === 'start' || item.artifact_type === 'diagnostic') },
  { id: 'project', title: 'Review the project', question: 'Where are release, milestone, policy, and public-information records?', items: entries.filter((item) => item.artifact_type !== 'learning-module' && item.route_namespace !== 'start' && item.artifact_type !== 'diagnostic') },
].filter(({ items }) => items.length);
const qualifier = (item: typeof entries[number]) => item.artifact_type === 'learning-module'
  ? `${item.module_type} module` : item.artifact_type === 'diagnostic' ? 'Recovery guide'
  : item.artifact_type === 'release' ? 'Release'
  : item.artifact_type === 'milestone' ? 'Milestone'
  : item.route_namespace === 'about' ? 'Project record'
  : item.route_namespace === 'events' ? 'Event'
  : item.artifact_type;
---
<BaseLayout title="Resources" description="Complete index of published Laptop-to-Cluster resources." profile="resources">
  <header class="content-header"><h1>Resources</h1><p class="lede">Every published page, grouped by what you are trying to do. Start with a question, then follow a link.</p></header>
  {groups.map((group) => (
    <section class="resource-section" aria-labelledby={`resource-${group.id}`}>
      <div class="resource-section__header">
        <h2 id={`resource-${group.id}`}>{group.title}</h2>
        <p class="resource-section__question">{group.question}</p>
      </div>
      <ul class="resource-grid">
        {group.items.map((item) => (
          <li><a class="resource-tile" href={canonicalPath(item)}>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            {qualifier(item) && <span class="resource-tile__tag">{qualifier(item)}</span>}
          </a></li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
<style>
  .resource-section { margin-block-start: var(--space-12); }
  .resource-section:first-of-type { margin-block-start: var(--space-8); }
  .resource-section__header { margin-block-end: var(--space-6); }
  .resource-section__question { color: var(--muted); font-size: var(--text-body); margin-block-start: var(--space-1); }
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-4);
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .resource-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: var(--border-thin) solid var(--border);
    border-radius: var(--radius-small);
    background: var(--raised);
    text-decoration: none;
    color: inherit;
  }
  .resource-tile:hover { border-color: var(--primary); background: var(--surface); }
  .resource-tile:active { border-color: var(--primary); background: var(--surface); }
  .resource-tile:focus-visible { outline-offset: 2px; }
  .resource-tile h3 { font-size: var(--text-subheading); font-weight: 700; flex: none; }
  .resource-tile p { color: var(--muted); font-size: var(--text-fine); line-height: 1.5; flex-grow: 1; }
  .resource-tile__tag {
    align-self: flex-start;
    font-family: var(--font-technical);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  @media (max-width: 30rem) {
    .resource-grid { grid-template-columns: 1fr; }
  }
</style>
