---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { canonicalPath } from '../../content/registry';
import { TALKS_LABEL } from '../../content/contracts';
import { currentBaselineRecord } from '../../content/projections';
import { RECORD_LINK_TEXT } from '../../content/wording';
interface Tile { href: string; title: string; summary: string; tag: string }
const published = (await getCollection('contentItems', ({ data }) => data.status === 'published')).map(({ data }) => data);
const byId = new Map(published.map((item) => [item.id, item]));
const record = currentBaselineRecord((await getCollection('applicability')).map(({ data }) => data));
const fromItem = (id: string, tag: string): Tile[] => {
  const item = byId.get(id);
  return item ? [{ href: canonicalPath(item), title: item.title, summary: item.summary, tag }] : [];
};
const groups = [
  {
    id: 'understand', title: 'Understand', question: 'What changes when a Compose stack moves to a shared cluster?',
    tiles: [
      ...fromItem('module-0-orientation', 'Tour'),
      ...fromItem('module-1-scheduler-orchestrator', 'Concept module'),
      ...fromItem('glossary', 'Reference'),
    ],
  },
  {
    id: 'translate', title: 'Translate', question: 'How do I turn my own Compose file into a cluster job?',
    tiles: [
      ...fromItem('module-3-compose-to-hpc-translation', 'Translate guide'),
      ...fromItem('start-guide', 'Hands-on'),
      ...fromItem('module-2-baseline', 'Hands-on module'),
      { href: '/diagnostics/', title: 'Troubleshooting', summary: 'Find a failure by the ID it prints, with recovery steps.', tag: 'Recovery guide' },
    ],
  },
  {
    id: 'evaluate', title: 'Evaluate and adopt', question: 'What was tested, what was not, and is this the right fit for my center?',
    tiles: [
      ...fromItem('adoption-evaluate', 'Evaluation guide'),
      ...(record ? [{ href: `/applicability/${record.id}/`, title: RECORD_LINK_TEXT, summary: 'What ran, where it ran, and what it checked.', tag: 'Evidence' }] : []),
      ...fromItem('milestone-1', 'Milestone'),
      ...fromItem('milestone-2', 'Milestone'),
      ...fromItem('talks-and-papers', TALKS_LABEL),
    ],
  },
].filter(({ tiles }) => tiles.length);
---
<BaseLayout title="Guide" description="A guided path through the Laptop-to-Cluster guide: understand the model, translate your own Compose file, then check what was tested." profile="resources">
  <header class="content-header"><h1>Guide</h1><p class="lede">Start with the idea, translate your own Compose file, then check what was tested and whether it fits your center.</p></header>
  {groups.map((group) => (
    <section class="resource-section" aria-labelledby={`resource-${group.id}`}>
      <div class="resource-section__header">
        <h2 id={`resource-${group.id}`}>{group.title}</h2>
        <p class="resource-section__question">{group.question}</p>
      </div>
      <ul class="resource-grid">
        {group.tiles.map((tile) => (
          <li><a class="resource-tile" href={tile.href}>
            <h3>{tile.title}</h3>
            <p>{tile.summary}</p>
            <span class="resource-tile__tag">{tile.tag}</span>
          </a></li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
