---
import { getCollection, render } from 'astro:content';
import Acknowledgment from '../../components/Acknowledgment.astro';
import ApplicabilityProjectionView from '../../components/ApplicabilityProjection.astro';
import Attribution from '../../components/Attribution.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BodySegments from '../../components/BodySegments.astro';
import ContentHeader from '../../components/ContentHeader.astro';
import LearningModuleLayout from '../../layouts/LearningModuleLayout.astro';
import ModulePager from '../../components/ModulePager.astro';
import RecordSummary from '../../components/RecordSummary.astro';
import SectionNav from '../../components/SectionNav.astro';
import SourcesAndScope from '../../components/SourcesAndScope.astro';
import SupportState from '../../components/SupportState.astro';
import TalksList from '../../components/TalksList.astro';
import { canonicalPath, hasNoStandalonePage } from '../../content/registry';
import { assertCompositionProfile, compositionProfileFor, currentBaselineRecord, projectApplicabilityForItem } from '../../content/projections';
import { ABOUT_NAV_ITEMS, learningPathNavigation, recordDateLine, slotNames, sortTalks } from '../../content/page-chrome';
import { formatDate } from '../../content/format';
import { currentReleaseVersion, RELEASE_REF_TOKEN, resolveReleaseRefs } from '../../content/release';
export async function getStaticPaths() {
  const entries = await getCollection('contentItems', ({ data }) =>
    ['published', 'superseded', 'archived'].includes(data.status) && data.route_namespace !== 'start' && !hasNoStandalonePage(data));
  return entries.map((entry) => { const [namespace, slug] = canonicalPath(entry.data).split('/').filter(Boolean); return { params: { namespace, slug }, props: { entry } }; });
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const bodyHtml = entry.rendered?.html === undefined ? undefined : resolveReleaseRefs(entry.rendered.html, currentReleaseVersion());
if (bodyHtml === undefined && entry.body?.includes(`/${RELEASE_REF_TOKEN}/`)) throw new Error(`${entry.id}: release-pinned links need rendered HTML to resolve`);
const item = entry.data;
const profile = compositionProfileFor(item);
assertCompositionProfile(item, profile);
const applicability = (await getCollection('applicability')).map(({ data }) => data);
const projection = item.artifact_type === 'milestone' ? projectApplicabilityForItem(item, applicability, 'milestone')
  : item.artifact_type === 'release' ? projectApplicabilityForItem(item, applicability, 'release') : undefined;
const dueDates = new Map((await getCollection('milestones')).map(({ data }) => [data.number, data.due_date] as const));
const dateLine = recordDateLine(item, dueDates);
const recordStatus = item.status[0].toUpperCase() + item.status.slice(1);
const currentPath = Astro.url.pathname;

/* Adoption pages show a summary of the current test record (D3); no other profile may. */
const isAdoption = item.artifact_type === 'checklist' && item.route_namespace === 'adoption';
const record = isAdoption ? currentBaselineRecord(applicability) : undefined;
if (isAdoption && !record) throw new Error(`${item.id}: the adoption page needs a current applicability record`);
const contentItems = (await getCollection('contentItems')).map(({ data }) => data);
const navigation = isAdoption ? learningPathNavigation(contentItems, item.id) : undefined;

/* Talks and papers reads the talks collection (§5.4); event pages may ask for the acknowledgment beside the PDF (D9). */
const talks = item.id === 'talks-and-papers' ? sortTalks((await getCollection('talks')).map(({ data }) => data)) : [];
const showAcknowledgment = item.artifact_type === 'event-assets'
  && 'acknowledgment_beside_download' in item && item.acknowledgment_beside_download === true;
const markers = new Set(bodyHtml ? slotNames(bodyHtml) : []);

/* D10: a release item that owns no page renders as a section of its milestone page. v0.1.0's notes are inline in milestone-1.md, so that item is excluded. */
const consolidatedReleases = item.artifact_type === 'milestone'
  ? await Promise.all((await getCollection('contentItems', ({ data }) =>
      data.artifact_type === 'release' && hasNoStandalonePage(data) && data.milestone === item.milestone
      && data.id !== 'release-v0-1-0' && data.status === 'published'))
    .map(async (releaseEntry) => ({ id: releaseEntry.data.id, title: releaseEntry.data.title, Content: (await render(releaseEntry)).Content })))
  : [];

/* Section navigation for Milestone pages (only when multiple milestones exist) */
const allEntries = await getCollection('contentItems', ({ data }) =>
  ['published', 'superseded', 'archived'].includes(data.status) && data.artifact_type === 'milestone');
const milestoneNavItems = allEntries
  .sort((a, b) => a.data.milestone - b.data.milestone)
  .map(({ data }) => ({
    label: `Milestone ${data.milestone}`,
    href: canonicalPath(data),
  }));
const showMilestoneNav = item.artifact_type === 'milestone' && milestoneNavItems.length > 1;
const showAboutNav = item.route_namespace === 'about';
---
{item.artifact_type === 'learning-module' ? <LearningModuleLayout {item} {bodyHtml}><Content /></LearningModuleLayout> :
<BaseLayout title={item.title} description={item.summary} {profile}>
  <ContentHeader {item} />
  {showAboutNav && <SectionNav items={[...ABOUT_NAV_ITEMS]} currentPath={currentPath} label="About sections" />}
  {showMilestoneNav && <SectionNav items={milestoneNavItems} currentPath={currentPath} label="Milestones" />}
  {dateLine && <p class="record-context"><strong>Status:</strong> {recordStatus} · <strong>{dateLine.label}:</strong> <time datetime={dateLine.iso}>{formatDate(dateLine.iso)}</time></p>}
  {projection && <ApplicabilityProjectionView {projection} />}
  {item.artifact_type === 'attribution' && <Attribution />}
  {record && !markers.has('record-summary') && <RecordSummary {record} />}
  {showAcknowledgment && !markers.has('acknowledgment') && <Acknowledgment variant="event" />}
  <article>
    {bodyHtml ? (
      <BodySegments html={bodyHtml}>
        <Fragment slot="record-summary">{record && <RecordSummary {record} />}</Fragment>
        <Fragment slot="talks">{talks.length > 0 && <TalksList {talks} />}</Fragment>
        <Fragment slot="acknowledgment">{showAcknowledgment && <Acknowledgment variant="event" />}</Fragment>
      </BodySegments>
    ) : <Content />}
  </article>
  {consolidatedReleases.map((release) => <section class="release-notes" id={release.id} aria-labelledby={`${release.id}-heading`}><h2 id={`${release.id}-heading`}>{release.title}</h2><release.Content /></section>)}
  {talks.length > 0 && !markers.has('talks') && <TalksList {talks} />}
  {item.artifact_type === 'support' && <SupportState />}
  {navigation && <ModulePager {navigation} />}
  <SourcesAndScope references={item.authority} />
</BaseLayout>}
