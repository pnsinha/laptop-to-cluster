---
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../content/format';
import { namedVersion, projectEvidencePanel } from '../../content/projections';
import { currentReadmeHref, evidenceHref, olderReadme, recordTitle, repositoryHref } from '../../content/record-page';
import { currentReleaseVersion } from '../../content/release';
import type { ApplicabilityRecord } from '../../content/schema';
export async function getStaticPaths() {
  return (await getCollection('applicability')).map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: { data: ApplicabilityRecord } };
const record = entry.data;
/* The provenance links stay pinned to the revision the run used. A README from an earlier release says so, and points at the current one. */
const currentRelease = currentReleaseVersion();
const readme = olderReadme(record, currentRelease);
const plainRows = record.plain_language ? projectEvidencePanel(record).rows : [];
const extension = record.review_extension;
/* The page reads top down: what the record means for a reader, the tested configuration, the checks and
   limits, then the hashes and provenance for anyone verifying the evidence. */
const title = recordTitle(record);
const headings: MarkdownHeading[] = [
  ...(plainRows.length > 0 ? [{ depth: 2, slug: 'plain-language', text: 'What this means for you' }] : []),
  { depth: 2, slug: 'tested-configuration', text: 'Tested configuration' },
  ...(extension ? [{ depth: 2, slug: 'review-extension', text: 'Review extension' }] : []),
  { depth: 2, slug: 'result-checks', text: 'Result checks' },
  { depth: 2, slug: 'assumptions', text: 'Assumptions' },
  { depth: 2, slug: 'limitations', text: 'Limitations' },
  { depth: 2, slug: 'portability-boundaries', text: 'Portability boundaries' },
  { depth: 2, slug: 'evidence-and-integrity', text: 'Evidence and integrity' },
  { depth: 2, slug: 'provenance', text: 'Provenance' },
];
---
<BaseLayout title={title} description={`Exact validation record for ${record.workflow_id}.`} profile="applicability" {headings} frontmatter={{ l2c: { kindLine: `Applicability record ${record.id}`, lede: `What ran, where it ran, and what it checked: the exact validation record for ${record.workflow_id}.` }, prev: false, next: false }}>
  {record.superseded_by && <p class="notice" role="note"><strong>Superseded:</strong> a newer test record replaces this one. See <a href={`/applicability/${record.superseded_by}/`}>{record.superseded_by}</a>.</p>}
  <section class="applicability-record" data-source-id={record.id} aria-labelledby="tested-configuration">
    {plainRows.length > 0 && <>
      <h2 id="plain-language">What this means for you</h2>
      <dl class="evidence-rows">{plainRows.map((row) => <div class="evidence-row"><dt>{row.label}</dt><dd><ul>{row.items.map((item) => <li data-from={item.from.join(' ')}>{item.text}</li>)}</ul></dd></div>)}</dl>
    </>}
    <h2 id="tested-configuration">Tested configuration</h2>
    <dl class="record-grid">
      <div><dt>Status</dt><dd>{record.status}</dd></div><div><dt>Environment</dt><dd>{record.environment.public_name}</dd></div>
      <div><dt>Environment role</dt><dd>{record.environment.fallback ? 'Fallback' : 'Primary'}</dd></div><div><dt>Environment scope</dt><dd>{record.environment.notes}</dd></div>
      <div><dt>Scheduler</dt><dd>{namedVersion(record.scheduler.family, record.scheduler.version)}</dd></div><div><dt>Runtime</dt><dd>{namedVersion(record.runtime.name, record.runtime.version)}</dd></div>
      <div><dt>Workflow revision</dt><dd><code>{record.workflow_revision}</code></dd></div><div><dt>Container image digest</dt><dd><code class="hash">{record.container_digest}</code></dd></div>
      <div><dt>Execution date</dt><dd><time datetime={record.execution_date}>{formatDate(record.execution_date)}</time></dd></div><div><dt>Validation date</dt><dd><time datetime={record.validation_date}>{formatDate(record.validation_date)}</time></dd></div>
      <div><dt>Submission ID</dt><dd><code>{record.submission_id}</code></dd></div><div><dt>Terminal result</dt><dd>{record.result.terminal_state}; exit {record.result.exit_code}</dd></div>
      <div><dt>Review after</dt><dd><time datetime={record.review_after}>{formatDate(record.review_after)}</time></dd></div>
    </dl>
    {extension && <>
      <h2 id="review-extension">Review extension</h2>
      <dl class="record-grid">
        <div><dt>Reviewed by</dt><dd>{extension.reviewed_by}</dd></div><div><dt>Reviewed on</dt><dd><time datetime={extension.reviewed_on}>{formatDate(extension.reviewed_on)}</time></dd></div>
        <div><dt>Review again by</dt><dd><time datetime={extension.review_by}>{formatDate(extension.review_by)}</time></dd></div>
      </dl>
      <p>{extension.scope_note}</p>
    </>}
    <h2 id="result-checks">Result checks</h2><ul>{record.result.checks.map((value) => <li>{value}</li>)}</ul>
    <h2 id="assumptions">Assumptions</h2><ul>{record.assumptions.map((value) => <li>{value}</li>)}</ul>
    <h2 id="limitations">Limitations</h2><ul>{record.limitations.map((value) => <li>{value}</li>)}</ul>
    <h2 id="portability-boundaries">Portability boundaries</h2><ul>{record.portability_boundaries.map((value) => <li>{value}</li>)}</ul>
    <h2 id="evidence-and-integrity">Evidence and integrity</h2><p><a href={evidenceHref(record, record.evidence.path)}>{record.evidence.id}</a></p><p><code class="integrity">{record.evidence.integrity}</code></p>
    {record.related_evidence.length > 0 && <>
      <h3 id="related-evidence">Related evidence</h3>
      <ul class="related-evidence">{record.related_evidence.map((reference) => <li><a href={evidenceHref(record, reference.path)}>{reference.id}</a> (negative test): <code class="integrity">{reference.integrity}</code></li>)}</ul>
    </>}
    <h2 id="provenance">Provenance</h2><ul>{record.provenance.map(({ label, reference }) => <li>{label}: <a href={repositoryHref(reference)}>{reference.path} at {reference.release}</a> (<code class="integrity">{reference.integrity}</code>)</li>)}</ul>
    {readme && <p class="provenance-note">This README predates the test run; the current README is in <a href={currentReadmeHref(readme, currentRelease)}>the release</a>.</p>}
  </section>
</BaseLayout>
