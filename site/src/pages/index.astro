---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ApplicabilityProjectionView from '../components/ApplicabilityProjection.astro';
import { projectLandingPage } from '../content/projections';
const content = await getCollection('contentItems');
const applicability = await getCollection('applicability');
const landing = projectLandingPage(content.map(({ data }) => data), applicability.map(({ data }) => data));
---
<BaseLayout title="Bridging the Laptop-to-Cluster Gap" description="Translate a multi-service Docker Compose stack to a scheduler-managed HPC allocation with Slurm and Apptainer." canonicalPath="/" profile="landing">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <h1 id="hero-title">Bridging the Laptop‑to‑Cluster Gap</h1>
      <p class="lede">A multi-service stack is trivial to run with Docker Compose on a laptop. On a shared cluster there is no Docker daemon, and the scheduler owns every resource. This guide is the translation.</p>
      <div class="hero__actions" aria-label="Start learning">
        <a class="action action--primary" href="/start/">Get started</a>
        <a class="hero__secondary-link" href={landing.learning_path[0].url}>Understand the model</a>
      </div>
    </div>
    <figure class="workflow-figure">
      <figcaption>One allocation, five ordered responsibilities</figcaption>
      <ol>
        <li><strong>Allocation</strong><span>Slurm grants one node and job-scoped resources.</span></li><i aria-hidden="true">↓</i>
        <li><strong>Coordinator</strong><span>The coordinating service starts on loopback inside the allocation.</span></li><i aria-hidden="true">↓</i>
        <li><strong>Readiness gate</strong><span>A semantic check must pass before workers start.</span></li><i aria-hidden="true">↓</i>
        <li><strong>Workers</strong><span>One or more exclusive worker steps start only after readiness.</span></li><i aria-hidden="true">↓</i>
        <li><strong>Verification</strong><span>Result invariants are checked before success is recorded.</span></li>
      </ol>
    </figure>
  </section>

  {landing.applicability_projection ? <ApplicabilityProjectionView projection={landing.applicability_projection} /> : <p class="notice notice--info">{landing.validation_unavailable_reason}</p>}

  <section aria-labelledby="mapping-title">
    <h2 id="mapping-title">Compose-to-HPC mapping</h2>
    <dl class="compose-mapping">
      <div><dt>service</dt><dd>scheduler job or step</dd></div>
      <div><dt>depends_on</dt><dd>explicit readiness check</dd></div>
      <div><dt>volumes</dt><dd>job-scoped scratch</dd></div>
      <div><dt>ports</dt><dd>loopback, reached by tunnel</dd></div>
    </dl>
  </section>

  <section aria-labelledby="path-title">
    <h2 id="path-title">Start here</h2>
    <ol class="path-list">
      <li><a href={landing.learning_path[0].url}><strong>Baseline Orchestration:</strong> Establish single-node parity with local development environments.</a></li>
      <li><a href={landing.learning_path[1].url}><strong>Prerequisites and center values:</strong> The values that differ at every HPC facility — account, partition, scratch path, and module names.</a></li>
      <li><a href={landing.learning_path[2].url}><strong>Run the baseline:</strong> Submit the single-node workflow and verify success from result artifacts.</a></li>
    </ol>
  </section>
</BaseLayout>
