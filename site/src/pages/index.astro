---
import { getCollection } from 'astro:content';
import { LinkButton } from '@astrojs/starlight/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import ApplicabilityProjectionView from '../components/ApplicabilityProjection.astro';
import ConceptMap from '../components/ConceptMap.astro';
import Crosswalk from '../components/Crosswalk.astro';
import Doors from '../components/Doors.astro';
import CrosswalkEnhancement from '../components/CrosswalkEnhancement.astro';
import { CROSSWALK } from '../content/crosswalk';
import { heroFigureHtml } from '../content/hero-figure';
import {
  CLOSING, CREDIT, DOORS_SECTION, EVENT_BAND, HERO, HOME_DESCRIPTION, HOME_TITLE,
  heroTaglineHtml, homeDoors, presentedAtLead, siteFacts,
} from '../content/home';
import { projectLandingPage } from '../content/projections';
import { currentReleaseVersion } from '../content/release';
import { RECORD_LINK_TEXT } from '../content/wording';

const content = (await getCollection('contentItems')).map(({ data }) => data);
const applicability = (await getCollection('applicability')).map(({ data }) => data);
// Evidence reaches the home page only through the landing projection.
const landing = projectLandingPage(content, applicability);
const recordHref = landing.applicability_projection?.canonicalPath;
const doors = homeDoors(content);
const talks = (await getCollection('talks')).map(({ data }) => data);
const presentedAt = presentedAtLead(talks);
const release = currentReleaseVersion();

/* Starlight's hero: the title, the kicker and lede as the tagline, the two-environment figure as
   custom markup, one filled action and one plain link. */
const hero = {
  title: HERO.title,
  tagline: heroTaglineHtml(),
  image: { html: heroFigureHtml() },
  actions: [
    { text: HERO.primary.label, link: HERO.primary.href, variant: 'primary' },
    { text: HERO.secondary.label, link: HERO.secondary.href, variant: 'minimal' },
  ],
};
---
<BaseLayout title={HOME_TITLE} description={HOME_DESCRIPTION} profile="landing" hasSidebar={true} frontmatter={{ template: 'splash', hero, tableOfContents: false, prev: false, next: false }}>
  {landing.applicability_projection ? <ApplicabilityProjectionView projection={landing.applicability_projection} /> : <p class="notice notice--info">{landing.validation_unavailable_reason}</p>}
  <p class="site-facts">{siteFacts(release)}</p>

  <section class="home-doors" aria-labelledby="doors-title">
    <h2 id="doors-title">{DOORS_SECTION.title}</h2>
    <Doors doors={doors} />
  </section>

  <ConceptMap />

  {recordHref ? (
    <Crosswalk data={CROSSWALK}><a slot="record" href={recordHref}>{RECORD_LINK_TEXT}</a></Crosswalk>
  ) : (
    <Crosswalk data={CROSSWALK} />
  )}

  <section class="home-close not-content" aria-labelledby="close-title">
    <h2 id="close-title">{CLOSING.title}</h2>
    <p>{CLOSING.lead}</p>
    <div class="home-close__actions">
      <LinkButton href={CLOSING.primary.href} variant="secondary">{CLOSING.primary.label}</LinkButton>
      <LinkButton href={CLOSING.secondary.href} variant="minimal">{CLOSING.secondary.label}</LinkButton>
    </div>
  </section>

  <p class="home-credit">{CREDIT.text} <a href={CREDIT.link.href}>{CREDIT.link.label}</a>.</p>

  {presentedAt && (
    <aside class="event-band not-content" aria-label={EVENT_BAND.label}>
      <p>{presentedAt}: <a href={EVENT_BAND.href}>{EVENT_BAND.linkText}</a></p>
    </aside>
  )}
  <CrosswalkEnhancement />
</BaseLayout>
