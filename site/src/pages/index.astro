---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ApplicabilityProjectionView from '../components/ApplicabilityProjection.astro';
import Crosswalk from '../components/Crosswalk.astro';
import Doors from '../components/Doors.astro';
import Timeline from '../components/Timeline.astro';
import { CROSSWALK } from '../content/crosswalk';
import {
  ANALOGY, BIG_IDEA, DOORS_SECTION, EVENT_BAND, HERO, HOME_DESCRIPTION, HOME_TITLE, PROJECT_RECORDS,
  TIMELINE_CAPTIONS, eventBandLead, homeDoors, projectRecordLinks,
} from '../content/home';
import { projectLandingPage } from '../content/projections';

const content = (await getCollection('contentItems')).map(({ data }) => data);
const applicability = (await getCollection('applicability')).map(({ data }) => data);
// Evidence reaches the home page only through the landing projection.
const landing = projectLandingPage(content, applicability);
const recordHref = landing.applicability_projection?.canonicalPath;
const doors = homeDoors(content);
const featuredTalk = (await getCollection('talks')).map(({ data }) => data).find(({ featured }) => featured);
const records = projectRecordLinks(landing.release);
---
<BaseLayout title={HOME_TITLE} description={HOME_DESCRIPTION} canonicalPath="/" profile="landing">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="kicker">{HERO.kicker}</p>
      <h1 id="hero-title">{HERO.title}</h1>
      <p class="lede" set:html={HERO.ledeHtml} />
      <div class="hero__actions">
        <a class="action action--primary" href={HERO.primary.href}>{HERO.primary.label}</a>
        <a class="hero__secondary-link" href={HERO.secondary.href}>{HERO.secondary.label}</a>
      </div>
      <p class="hero__quiet">{HERO.quiet.lead} <a href={HERO.quiet.href}>{HERO.quiet.label}</a></p>
    </div>
  </section>

  {landing.applicability_projection ? <ApplicabilityProjectionView projection={landing.applicability_projection} /> : <p class="notice notice--info">{landing.validation_unavailable_reason}</p>}

  <section class="big-idea" id="big-idea" aria-labelledby="big-idea-title">
    <h2 id="big-idea-title">{BIG_IDEA.title}</h2>
    <p set:html={BIG_IDEA.proseHtml} />
    <Timeline captions={TIMELINE_CAPTIONS} />
    <div class="analogy">
      <h3>{ANALOGY.title}</h3>
      <p set:html={ANALOGY.bodyHtml} />
      <h4>{ANALOGY.breaksTitle}</h4>
      <ul class="analogy__breaks">
        {ANALOGY.breaks.map(({ lead, text }) => <li><strong>{lead}</strong> {text}</li>)}
      </ul>
    </div>
  </section>

  <section aria-labelledby="doors-title">
    <h2 id="doors-title">{DOORS_SECTION.title}</h2>
    <Doors doors={doors} />
  </section>

  {recordHref ? (
    <Crosswalk data={CROSSWALK}><a slot="record" href={recordHref}>Full test record</a></Crosswalk>
  ) : (
    <Crosswalk data={CROSSWALK} />
  )}

  {featuredTalk && (
    <aside class="event-band" aria-label={EVENT_BAND.label}>
      <p>{eventBandLead(featuredTalk)}: <a href={EVENT_BAND.href}>{EVENT_BAND.linkText}</a></p>
    </aside>
  )}

  <section class="project-links" aria-labelledby="project-links-title">
    <h2 id="project-links-title">{PROJECT_RECORDS.title}</h2>
    <ul>
      {records.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
    </ul>
    <p>{PROJECT_RECORDS.visitLead} <a href={PROJECT_RECORDS.visitHref}>{PROJECT_RECORDS.visitLinkText}</a></p>
  </section>
</BaseLayout>
